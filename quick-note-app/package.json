{
  "name": "quick-note",
  "version": "1.0.0",
  "description": "Phillip-OS Task Manager: notes, call logs, today's to-dos and reminders, a calendar, and countdowns.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prestart": "node fix-electron-dist.js",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.phillipos.quicknote",
    "productName": "Phillip-OS Task Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
